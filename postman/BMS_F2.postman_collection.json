    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "locationId",
      "value": "1"
    },
    {
      "key": "courtId",
      "value": "1"
    },
    {
      "key": "date",
      "value": "2026-11-02"
    },
    {
      "key": "priceRuleId",
      "value": "1"
    },
    {
      "key": "batchOfferId",
      "value": "1"
    },
    {
      "key": "openingExceptionId",
      "value": "1"
    },
    {
      "key": "maintenanceId",
      "value": "1"
    },
    {
      "key": "serviceRegistrationId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "00 - Auth (chạy trước)",
      "item": [
        {
          "name": "Login owner1",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "const token = (res.data && res.data.token) || res.token;",
                  "if (token) {",
                  "    pm.collectionVariables.set('token', token);",
                  "    pm.test('Login OK, đã lưu token (độ dài ' + token.length + ')', () => pm.expect(token.length).to.be.above(50));",
                  "} else {",
                  "    pm.test('Login thất bại — không tìm thấy token trong response', () => pm.expect.fail(JSON.stringify(res)));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"owner1\",\n  \"password\": \"Bms@12345\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Login admin",
          "event": [
            {
