    {
      "name": "F2 - UC07 Địa điểm & sân (OWNER)",
      "item": [
        {
          "name": "01 - GET địa điểm của tôi",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('success = true', () => pm.expect(r.success).to.eql(true));",
                  "pm.test('có ít nhất 1 địa điểm', () => pm.expect(r.data.length).to.be.above(0));",
                  "pm.collectionVariables.set('locationId', r.data[0].id);",
                  "console.log('locationId =', r.data[0].id, '|', r.data[0].name);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/owner/locations"
          }
        },
        {
          "name": "02 - GET sân của địa điểm",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('có ít nhất 1 sân', () => pm.expect(r.data.length).to.be.above(0));",
                  "pm.collectionVariables.set('courtId', r.data[0].id);",
                  "pm.collectionVariables.set('courtNameSeed', r.data[0].name);",
                  "console.log('courtId =', r.data[0].id, '| tổng', r.data.length, 'sân');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/owner/locations/{{locationId}}/courts"
          }
        },
        {
          "name": "03 - POST thêm sân mới",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const n = 'Sân Test ' + Math.floor(Math.random() * 100000);",
                  "pm.collectionVariables.set('newCourtName', n);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.test('tên sân đúng như gửi lên', () => pm.expect(r.data.name).to.eql(pm.collectionVariables.get('newCourtName')));",
                  "pm.test('sân mới mặc định active', () => pm.expect(r.data.active).to.eql(true));",
                  "pm.collectionVariables.set('newCourtId', r.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/owner/locations/{{locationId}}/courts",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{newCourtName}}\",\n  \"description\": \"Sân tạo bởi Postman Runner\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
