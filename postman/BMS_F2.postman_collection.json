    {
      "name": "F2 - UC08 Giờ mở cửa & ngày ngoại lệ (OWNER)",
      "item": [
        {
          "name": "01 - GET giờ mở cửa",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('luôn trả đủ 7 ngày', () => pm.expect(r.data.length).to.eql(7));",
                  "pm.test('có dayName tiếng Việt', () => pm.expect(r.data[0].dayName).to.eql('Thứ 2'));",
                  "pm.test('mỗi ngày có cờ configured', () => pm.expect(r.data.every(d => typeof d.configured === 'boolean')).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/owner/locations/{{locationId}}/opening-hours"
          }
        },
        {
          "name": "02 - PUT giờ mở cửa 7 ngày",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('7/7 ngày đã cấu hình', () => pm.expect(r.data.filter(d => d.configured).length).to.eql(7));",
                  "pm.test('giờ đúng 06:00 - 23:30', () => pm.expect(r.data[0].openTime).to.eql('06:00') && pm.expect(r.data[0].closeTime).to.eql('23:30'));",
                  "pm.test('durationMinutes = 1050', () => pm.expect(r.data[0].durationMinutes).to.eql(1050));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
