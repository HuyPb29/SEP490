      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const t = pm.collectionVariables.get('token');",
          "const url = pm.request.url.toString();",
          "if (!t && !url.includes('/api/auth/login')) {",
          "    console.warn('⚠️ CHƯA CÓ TOKEN — mở folder \"00 - Auth (chạy trước)\" và chạy \"Login owner1\" trước.');",
          "    console.warn('   Header đang gửi: ' + (pm.request.headers.get('Authorization') || '(không có)'));",
          "} else if (t) {",
          "    console.log('token OK, độ dài = ' + t.length);",
          "}"
        ]
      }
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  }
