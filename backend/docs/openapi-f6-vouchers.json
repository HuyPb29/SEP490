            "maxLength" : 20,
            "minLength" : 0
          },
          "grantId" : {
            "type" : "integer",
            "format" : "int64",
            "exclusiveMinimum" : 0
          },
          "selectionValid" : {
            "type" : "boolean"
          }
        }
      },
      "ApiResponseVoucherCheckResponse" : {
        "type" : "object",
        "properties" : {
          "success" : {
            "type" : "boolean"
          },
          "message" : {
            "type" : "string"
          },
