            "format" : "date-time"
          }
        }
      },
      "VoucherCheckResponse" : {
        "type" : "object",
        "properties" : {
          "voucherId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "grantId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "orderAmount" : {
            "type" : "number"
          },
          "discountAmount" : {
            "type" : "number"
          },
          "amountAfterVoucher" : {
            "type" : "number"
          }
        }
      },
      "VoucherWriteRequest" : {
        "type" : "object",
        "properties" : {
          "code" : {
            "type" : "string",
            "maxLength" : 20,
            "minLength" : 0,
            "pattern" : "[A-Za-z0-9_-]+"
          },
          "name" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          },
          "targetGroup" : {
            "type" : "string",
            "enum" : [ "ALL_PLAYERS", "NEW_PLAYERS", "SPECIFIED" ]
          },
          "discountType" : {
            "type" : "string",
            "enum" : [ "PERCENT", "AMOUNT" ]
          },
          "discountValue" : {
            "type" : "number",
            "minimum" : 1
          },
          "minOrderAmount" : {
            "type" : "number",
            "minimum" : 0
          },
          "validFrom" : {
            "type" : "string",
            "format" : "date"
          },
          "validTo" : {
            "type" : "string",
            "format" : "date"
          },
          "grantValidDays" : {
            "type" : "integer",
            "format" : "int32",
            "maximum" : 3650,
            "minimum" : 1
          },
          "maxUsesPerPlayer" : {
            "type" : "integer",
            "format" : "int32",
            "minimum" : 1
          },
          "maxTotalUses" : {
            "type" : "integer",
            "format" : "int32",
            "minimum" : 1
          },
          "budget" : {
            "type" : "number",
            "minimum" : 1
          },
          "dateRangeValid" : {
            "type" : "boolean"
          },
          "percentageValid" : {
            "type" : "boolean"
          },
          "codeValid" : {
            "type" : "boolean"
          }
        },
        "required" : [ "discountType", "discountValue", "minOrderAmount", "name", "targetGroup", "validFrom", "validTo" ]
      },
      "ApiResponseVoucherResponse" : {
        "type" : "object",
        "properties" : {
          "success" : {
            "type" : "boolean"
          },
          "message" : {
            "type" : "string"
          },
          "data" : {
            "$ref" : "#/components/schemas/VoucherResponse"
          },
          "errors" : { },
          "timestamp" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "VoucherResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "locationId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "code" : {
            "type" : "string"
          },
          "name" : {
